{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Godot: Start project editor",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\start-godot.ps1",
        "-ProjectRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1,
        "instancePolicy": "silent"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true,
        "clear": true
      }
    }
  ]
}
