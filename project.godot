; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PVZ In Hell Simulator"
config/tags=PackedStringArray("game", "gecs")
run/main_scene="uid://b357k3h2k7kuh"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=120
boot_splash/stretch_mode=0
config/icon="uid://drdfwuxt63ajy"

[audio]

buses/default_bus_layout="uid://yl83ywtlw332"

[autoload]

Audio="*uid://cujwm7u5pvogl"
InputHelper="*uid://cholww48njaeh"
DialogueManager="*uid://c3rodes2l3gxb"
Console="*uid://ouiu5xh1cs8n"
ECS="*uid://dfqwl5njvdnmq"
DebugD3D="*res://addons/debug_draw/debug_draw_3d.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Cogito"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/asset_placer/plugin.cfg", "res://addons/at-icons/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/gecs/plugin.cfg", "res://addons/godoban/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/input_helper/plugin.cfg", "res://addons/quick_audio/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "blue",
"res://content/": "orange",
"res://godoban_boards/": "gray",
"res://materials/": "purple",
"res://resources/": "yellow",
"res://tests/": "gray",
"res://utils/": "pink"
}

[gui]

theme/default_theme_scale=2.0

[importer_defaults]

wav={
"edit/loop_mode": 1
}

