extends Component
## Авторские пределы толкания физической тележки, независимые от Grab и вместимости рук.
class_name C_Pushable

## Скорость мотора вперёд в м/с; обратное направление не движет тележку.
@export_range(0.1, 5.0, 0.1) var forward_speed: float = 1.4
## Скорость поворота в рад/с, независимая от чувствительности мыши.
@export_range(0.1, 3.0, 0.1) var turn_speed: float = 0.8
## Предельная дистанция актора от тележки в метрах до освобождения управления.
@export_range(0.5, 6.0, 0.1) var focus_distance: float = 3.0
## Минимальный горизонтальный dot направления взгляда к тележке, 0–1.
@export_range(0.0, 1.0, 0.05) var minimum_front_dot: float = 0.25
## Расстояние за центром тележки до ручки, за которой следует игрок, в метрах.
@export_range(0.5, 3.0, 0.1) var handle_distance: float = 1.3
## Предельная скорость физического следования за ручкой в м/с, без прямой записи transform.
@export_range(0.1, 6.0, 0.1) var follow_speed: float = 2.0
