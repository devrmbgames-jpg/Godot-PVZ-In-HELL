extends RefCounted
## Временное предложение подтверждения; receipt создаётся только после повторной проверки.
class_name BuybackQuote

## ID одного подтверждения; повтор использует тот же ID, смена состава требует нового quote.
var operation_id: StringName = &""
## Точный контейнер текущего UI-сеанса; delayed confirm повторно проверяет регистрацию.
var container_reference: WeakRef
## Точный C_Buyback контейнера; замена Component инвалидирует предложение.
var state: C_Buyback
## День показанного прайса, начиная с1.
var day_index: int = 0
## ID утренней поставки, по которой подготовлен спрос.
var supply_batch_id: String = ""
## Постоянный ID физического продавца на момент подготовки предложения.
var trader_id: String = ""
## Сигнатура всех принимаемых физических стеков и цен; не hash с возможными коллизиями.
var signature: String = ""
## Только текущая физическая композиция, включая отказанные native тела; никогда не сохраняется.
var composition_signature: String = ""
## Показанный остаток дневного спроса на момент этого quote; UI не читает меняющийся прайс.
var market_lines: PackedStringArray = []
## Detached элементы предлагаемой партии; никакие предметы ещё не удалены или зарезервированы.
var items: Array[BuybackSaleItem] = []
## Отказанные предметы с причинами, без автоматического удаления неизвестных вещей.
var rejected: PackedStringArray = []
## Точная сумма показанного подтверждения.
var amount: int = 0
## Понятная причина общей недоступности, например ожидание фактической поставки.
var reason: String = ""
