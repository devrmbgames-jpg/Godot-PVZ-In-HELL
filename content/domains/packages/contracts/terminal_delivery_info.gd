extends RefCounted
## Временное представление известных сведений доставки; не является записью обещания или сохранением.
class_name TerminalDeliveryInfo

## Постоянный ID предложения для запросов принятия/отказа.
var job_id: StringName = &""
## Сведения явно опубликованы системе; частные договорённости по умолчанию скрыты.
var published: bool = false
## Известный системе адрес, уже подготовленный сервисом для показа игроку.
var address: String = ""
## Согласованная доплата за доставку в целых денежных единицах.
var bonus: int = 0
## Номер утра, до которого действует известный системе срок доставки.
var deadline_day: int = 0
## Опубликованный статус предложения/обязательства, без раскрытия сценария и природы NPC.
var status: NpcHomeDelivery.Status = NpcHomeDelivery.Status.OFFERED
## Известная формулировка состояния для подробностей и подсказок строки.
var status_text: String = ""
## Сейчас разрешён запрос принятия/отказа; сервис повторно проверяет его пригодность.
var can_respond: bool = false
