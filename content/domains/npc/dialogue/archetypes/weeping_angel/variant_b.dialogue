import "res://content/domains/npc/dialogue/npc_street.dialogue" as street_flow
import "res://content/domains/customers/dialogue/customer_service.dialogue" as service

~ street
Табличка: ГЛАЗ — СВЕЧА. НЕ ГАСИ ЕЁ МЕЖДУ НАМИ.
- Я читаю твой знак. [#hon] => warning
- Зачем тебе эти таблички? => silence
- Какую святыню ты ждёшь? => goods
- Могу доставить её к твоей двери. [if ctx.can_offer_delivery() /] => delivery_request
- Пусть свет останется с тобой. => END

~ direct
if ctx.has_registered_number()
	Табличка: ПЕЧАТЬ №{{ctx.package_number_text()}}. ПОД НЕЮ — ОЖИДАЕМАЯ СВЯТЫНЯ.
	- Проверю номер и целостность посылки. => END
	- Что за святыню ты заказал? => goods
	- Обсудим доставку к твоей двери. [if ctx.can_offer_delivery() /] => home_request
	- Сегодня выдача невозможна. => deny_start
else
	Табличка: ПЕЧАТЬ НЕ НАЗВАНА. СНАЧАЛА ПРОСКАНИРУЙТЕ ПОСТУПИВШИЕ ПОСЫЛКИ.
=> END

~ warning
Табличка: ПОКА ТЫ ВИДИШЬ МЕНЯ, Я — ИЗОБРАЖЕНИЕ. НЕ СПЕШИ УЗНАВАТЬ, ЧТО ЗА РАМОЙ.
- Я сохраню взгляд. [#hon] => assurance
- Пусть наша сделка будет мирной. [#prs] => assurance
- За рамой пусто. Я проверял. [#lie] => provocation
- Я разобью эту раму. [#thr] => threat

~ assurance
Табличка: ПУСТЬ ТВОЙ ВЗГЛЯД НЕ ДРОГНЕТ. ПУСТЬ ТВОЁ СЛОВО НЕ СОТРЁТСЯ.
=> END

~ silence
Табличка: ГОЛОС БУДИТ КАМЕНЬ. БУКВЫ ПОЗВОЛЯЮТ ЕМУ СПАТЬ.
- Я не стану его будить. [#hon] => warning
- На камне ведь и долговые расписки долговечнее. [#jok] => joke
- Расскажи надписью о своей посылке. => goods
- Я понял знак. => END

~ goods
Табличка: РЕЛИКВИЯ ДЛЯ ПУСТОГО АЛТАРЯ. СВЕТ ДЛЯ ВНУТРЕННЕЙ СТОРОНЫ ВЕК.
- Какой след она оставит? => artifact
- Я донесу её к твоей двери. [if ctx.can_offer_delivery() /] => delivery_request
- Печать останется целой. [#hon] => assurance
- Пускай прибудет в срок. => END

~ artifact
Табличка: СВЯТЫНЯ ПОМНИТ ИМЯ ТОГО, КТО ЕЁ КОСНУЛСЯ. ОБЫЧНЫЙ КЛИНОК ИМЁН НЕ ПОМНИТ.
=> END

~ provocation
if ctx.is_customer_service()
	=> service/provocation
else
	=> street_flow/provocation

~ broken_promise
if ctx.is_customer_service()
	=> service/broken_promise
else
	=> street_flow/broken_promise

~ challenge
=> service/challenge

~ provocation_answer
=> service/provocation_answer

~ followup
=> service/followup

