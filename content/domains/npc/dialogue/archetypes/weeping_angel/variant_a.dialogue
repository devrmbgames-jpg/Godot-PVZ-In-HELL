import "res://content/domains/npc/dialogue/npc_street.dialogue" as street_flow
import "res://content/domains/customers/dialogue/customer_service.dialogue" as service

~ street
Табличка: НЕ ОТВОДИ ВЗГЛЯД, ПОКА МЫ ДОГОВАРИВАЕМСЯ.
- Я прочитал предупреждение. [#hon] => warning
- Почему ты пишешь, а не говоришь? => silence
- Что тебе нужно доставить? => goods
- Могу принести посылку домой. [if ctx.can_offer_delivery() /] => delivery_request
- Я смотрю. До встречи. => END

~ direct
if ctx.has_registered_number()
	Табличка: ЗАКАЗ №{{ctx.package_number_text()}}. АРТЕФАКТ. ВЫДАТЬ ЦЕЛЫМ.
	- Сейчас проверю вашу посылку. => END
	- Что за артефакт? => goods
	- Договоримся о доставке домой. [if ctx.can_offer_delivery() /] => home_request
	- Сегодня выдача невозможна. => deny_start
else
	Табличка: НОМЕРА НЕТ. СНАЧАЛА ПРОСКАНИРУЙТЕ ПОСТУПИВШИЕ ПОСЫЛКИ.
=> END

~ warning
Табличка: ВЗГЛЯД УДЕРЖИВАЕТ МЕНЯ. ТИШИНА УДЕРЖИВАЕТ РАЗГОВОР.
- Я буду внимателен. [#hon] => assurance
- Давай спокойно закончим выдачу. [#prs] => assurance
- Я уже отвернулся, и ничего не случилось. [#lie] => provocation
- Попробуй подойти ещё ближе. [#thr] => threat

~ assurance
Табличка: ПРИНЯТО. ДЕРЖИ ДИСТАНЦИЮ. ДЕРЖИ СЛОВО.
=> END

~ silence
Табличка: У СЛОВ ЕСТЬ ЭХО. У НАДПИСИ ЕСТЬ КРАЙ.
- Тогда прочитаю внимательно. [#hon] => warning
- Хорошая экономия на телефонных звонках. [#jok] => joke
- Что будет в посылке? => goods
- Всё понятно. => END

~ goods
Табличка: АРТЕФАКТЫ. СВЯТЫНИ. ПЕЧАТИ. НЕ ВСКРЫВАТЬ ДО ВЫДАЧИ.
- Почему тебе нужны святыни? => artifact
- Могу доставить их домой. [if ctx.can_offer_delivery() /] => delivery_request
- Сохраню упаковку. [#hon] => assurance
- Достаточно. => END

~ artifact
Табличка: СВЯТОЕ ОСТАВЛЯЕТ СЛЕД. ОСТАЛЬНОЕ ОСТАВЛЯЕТ ШУМ.
=> END

~ provocation
if ctx.is_customer_service()
	=> service/provocation
else
	=> street_flow/provocation

~ broken_promise
if ctx.is_customer_service()
	=> service/broken_promise
else
	=> street_flow/broken_promise

~ challenge
=> service/challenge

