[gd_resource type="Resource" script_class="DEF_EntityTemplate" format=3]

[ext_resource type="Script" path="res://content/shared/definitions/def_entity_template.gd" id="Template"]
[ext_resource type="Script" path="res://content/shared/authoring/entity_trait.gd" id="Trait"]
[ext_resource type="Script" path="res://content/domains/npc/components/c_district.gd" id="District"]

[sub_resource type="Resource" id="Roster"]
script = ExtResource("Trait")
trait_id = &"district_roster"
required_components = Array[Script]([ExtResource("District")])
initial_field_names = Dictionary[Script, PackedStringArray]({
ExtResource("District"): PackedStringArray("people", "next_person")
})

[resource]
script = ExtResource("Template")
key = &"entity_district_session"
traits = Array[ExtResource("Trait")]([SubResource("Roster")])
