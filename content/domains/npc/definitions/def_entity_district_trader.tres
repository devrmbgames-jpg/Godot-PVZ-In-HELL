[sub_resource type="Resource" id="Brain"]
script = ExtResource("Brain")

[sub_resource type="Resource" id="Identity"]
script = ExtResource("Identity")

[resource]
script = ExtResource("Template")
key = &"entity_district_trader"
traits = Array[ExtResource("Trait")]([SubResource("Identity"), SubResource("Brain"), SubResource("Roles")])
