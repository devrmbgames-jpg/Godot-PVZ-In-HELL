[gd_resource type="Resource" script_class="DEF_EntityTemplate" format=3]

[ext_resource type="Script" path="res://content/shared/definitions/def_entity_template.gd" id="Template"]
[ext_resource type="Script" path="res://content/shared/authoring/entity_trait.gd" id="Trait"]
[ext_resource type="Script" path="res://content/domains/npc/authoring/et_npc_identity.gd" id="Identity"]

[ext_resource type="Script" path="res://content/domains/npc/authoring/et_npc_brain_state.gd" id="Brain"]

[ext_resource type="Script" path="res://content/domains/npc/authoring/et_npc_roles.gd" id="Roles"]
[ext_resource type="Resource" path="res://content/domains/needs/definitions/def_hunger_default.tres" id="Hunger_policy"]
[ext_resource type="Resource" path="res://content/domains/npc/definitions/def_action_npc_street.tres" id="Street_action"]

[sub_resource type="Resource" id="Roles"]
script = ExtResource("Roles")
action_set_provider = 1
trader_provider = 1
