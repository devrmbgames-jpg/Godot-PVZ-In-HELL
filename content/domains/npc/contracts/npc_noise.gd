extends RefCounted
## Короткоживущее звуковое событие; позиция слышна, личность требует распознавания.
class_name NpcNoise

## Последовательный номер звука для однократной обработки.
var sequence: int = 0
## Оставшиеся GamePlay seconds: emit_noise задаёт два decision_interval, S_NpcNoise уменьшает.
## Это ограниченный TTL, а не гарантия доставки каждому NPC при отложенном due budget.
var remaining: float = 0.5
## Зафиксированная мировая позиция звука в метрах; за движущимся источником не следует.
var position: Vector3 = Vector3.ZERO
## Радиус слышимости в метрах до ослабления препятствиями.
var radius: float = 8.0
## Звук требует проверки свободным NPC; шаги прохожих слышны, но не собирают весь район в одной
## точке.
var investigate: bool = true
## Borrowed источник для исключения self-noise и его коллайдера из слухового луча.
## Может исчезнуть до hear; это поле не сообщает личность слушателю и не владеет Node.
var source: Entity = null
