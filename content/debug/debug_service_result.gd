extends RefCounted
## Результат отладочного адаптера: принятие запроса, пояснение и строки диагностики.
class_name DebugServiceResult

## Успех по контракту конкретного адаптера: принятие запроса либо завершённая операция.
## Сам флаг не является domain receipt и не гарантирует физический эффект.
var success: bool = false
## Пояснение принятия или причина отказа.
var message: String = ""
## Снятый строковый контекст команды; не живая ссылка на состояние домена.
var details: PackedStringArray = []
