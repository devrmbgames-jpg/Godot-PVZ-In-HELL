[gd_scene format=3]
[ext_resource type="Script" path="res://content/ui/terminal_panel.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.035, 0.055, 0.07, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.45, 0.5, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10

[node name="TerminalPanel" type="CanvasLayer"]
layer = 5
script = ExtResource("1")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Shade" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.65)

[node name="Panel" type="PanelContainer" parent="Root"]
theme_override_styles/panel = SubResource("PanelStyle")
layout_mode = 1
anchor_left = 0.1
anchor_top = 0.08
anchor_right = 0.9
anchor_bottom = 0.92

[node name="Margin" type="MarginContainer" parent="Root/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Rows" type="VBoxContainer" parent="Root/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Root/Panel/Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Hint" type="Label" parent="Root/Panel/Margin/Rows"]
theme_override_font_sizes/font_size = 18
layout_mode = 2
text = "Номер · содержимое · комментарий · состояние\nМесто хранения выбираете и запоминаете вы."

[node name="Registry" type="RichTextLabel" parent="Root/Panel/Margin/Rows"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 20

[node name="Close" type="Button" parent="Root/Panel/Margin/Rows"]
theme_override_font_sizes/font_size = 20
layout_mode = 2
text = "Закрыть  [E / Esc]"
