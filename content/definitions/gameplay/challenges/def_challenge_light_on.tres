[gd_resource type="Resource" script_class="DEF_Challenge" format=3]

[ext_resource type="Script" path="res://content/definitions/gameplay/challenges/def_challenge.gd" id="Challenge"]
[ext_resource type="Script" path="res://content/definitions/gameplay/challenges/def_light_challenge_condition.gd" id="Condition"]

[sub_resource type="Resource" id="Condition"]
script = ExtResource("Condition")
circuit_id = &"warehouse"
required_enabled = true

[resource]
script = ExtResource("Challenge")
key = &"warehouse-light-on"
condition = SubResource("Condition")
rule_text = "Включите свет в помещении. Выключатель рядом с пультом смены."
timeout_seconds = 20.0
