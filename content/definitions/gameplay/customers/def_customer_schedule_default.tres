[sub_resource type="Resource" id="Careful"]
script = ExtResource("Customer")
challenge = ExtResource("ChallengeOn")
dialogue_reactions = Array[ExtResource("Reaction")]([SubResource("ReactionHonest"), SubResource("ReactionLie"), SubResource("ReactionPersuade"), SubResource("ReactionThreat"), SubResource("ReactionCarefulFlirt"), SubResource("ReactionJoke")])
display_name = "Покупатель посуды"
accepts_damaged = false
accepts_opened = false
dialogue_mode = 1
key = &"careful"

[sub_resource type="Resource" id="Glass"]
script = ExtResource("Event")
package_key = &"glass"
customer = SubResource("Careful")

[sub_resource type="Resource" id="Refusal"]
script = ExtResource("Customer")
challenge = ExtResource("ChallengeVisit")
dialogue_reactions = Array[ExtResource("Reaction")]([SubResource("ReactionHonest"), SubResource("ReactionLie"), SubResource("ReactionPersuade"), SubResource("ReactionThreat"), SubResource("ReactionFlirt"), SubResource("ReactionJoke")])
display_name = "Покупатель одежды"
voluntary_refusal = true
key = &"voluntary_refusal"

[sub_resource type="Resource" id="Clothes"]
script = ExtResource("Event")
package_key = &"clothes"
customer = SubResource("Refusal")

[sub_resource type="Resource" id="Late"]
script = ExtResource("Customer")
