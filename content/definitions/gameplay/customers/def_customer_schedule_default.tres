[sub_resource type="Resource" id="Equipment"]
script = ExtResource("Event")
package_key = &"equipment"
arrival_delay_days = 10
customer = SubResource("Late")

[sub_resource type="Resource" id="GazeEvent"]
script = ExtResource("Event")
package_key = &"bottles"
customer = ExtResource("GazeCustomer")

[resource]
script = ExtResource("Schedule")
events = Array[ExtResource("Event")]([SubResource("Books"), SubResource("Glass"), SubResource("Clothes"), SubResource("Equipment"), SubResource("GazeEvent")])
customer_scene = ExtResource("Scene")
key = &"warehouse_customers"
