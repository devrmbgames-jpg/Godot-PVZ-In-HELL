# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = [[
        "git",
        "git.exe",
        "C:\\Program Files\\Git\\cmd\\git.exe",
        "C:\\Program Files\\Git\\bin\\git.exe",
    ], [
        "add",
        "commit",
        "status",
        "diff",
        "log",
        "show",
        "branch",
        "checkout",
        "switch",
        "restore",
        "fetch",
        "pull",
        "push",
        "merge",
        "rebase",
        "worktree",
        "tag",
        "rev-parse",
        "rev-list",
        "merge-base",
    ]],
    decision = "allow",
    justification = "Normal Git development operations are trusted in this repository.",
)


prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard repository changes automatically.",
)




# ---------------------------------------------------------------------------
# Godot binaries from project .bin/
# ---------------------------------------------------------------------------

prefix_rule(
    pattern = [[
        ".\\.bin\\Godot_v4.7.1-stable_win64_console.exe",
        ".\\.bin\\Godot_v4.7.1-stable_win64.exe",
        ".bin\\Godot_v4.7.1-stable_win64_console.exe",
        ".bin\\Godot_v4.7.1-stable_win64.exe",
    ]],
    decision = "allow",
    justification = "Project-local Godot binaries are trusted for parser, headless tests and tooling.",
)