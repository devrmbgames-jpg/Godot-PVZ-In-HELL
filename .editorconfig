root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.gd]
indent_style = tab
indent_size = 4
max_line_length = 100
trim_trailing_whitespace = true
# Save-time formatting stays opt-in while Phase 3 migrates files in reviewed batches.
gdscript_formatter_format_on_save = false

[*.{tscn,tres}]
indent_style = tab
trim_trailing_whitespace = true
