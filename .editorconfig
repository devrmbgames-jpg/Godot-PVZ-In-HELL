root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.gd]
indent_style = tab
indent_size = 4
max_line_length = 100
trim_trailing_whitespace = true
# Avoid mass rewrites of legacy code before the dedicated Phase 3 pass.
gdscript_formatter_format_on_save = false

[*.{tscn,tres}]
indent_style = tab
trim_trailing_whitespace = true
